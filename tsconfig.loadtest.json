{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "ES2020",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": ["node", "jest"]
  },
  "include": [
    "load-test-engine.ts",
    "load-test-reporter.ts",
    "load-test.config.ts",
    "load-test.ts"
  ],
  "exclude": ["node_modules", "dist", "build", ".docusaurus"]
}