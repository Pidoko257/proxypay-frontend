{
  "extends": "lighthouse:recommended",
  "settings": {
    "output": ["json", "html"],
    "onlyCategories": ["performance", "accessibility", "best-practices", "seo"],
    "formFactor": "desktop",
    "screenEmulation": {
      "mobile": false,
      "width": 1280,
      "height": 720,
      "deviceScaleFactor": 1,
      "disabled": false
    }
  }
}
