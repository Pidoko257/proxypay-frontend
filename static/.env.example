# ── Server ──────────────────────────────────────────────────────────────────
PORT=3000                              # type:number   required:false
NODE_ENV=development                   # type:string   required:false

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=                          # type:url      required:true  | PostgreSQL connection string
REDIS_URL=                             # type:url      required:true  | Redis connection string for caching and queues

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=                            # type:string   required:true  | Secret for signing JWT access tokens
JWT_EXPIRES_IN=24h                     # type:string   required:false | Access token TTL (e.g. 1h, 7d)
REFRESH_TOKEN_SECRET=                  # type:string   required:true  | Secret for signing refresh tokens
REFRESH_TOKEN_EXPIRES_IN=30d           # type:string   required:false | Refresh token TTL
API_KEY_SALT_ROUNDS=12                 # type:number   required:false | bcrypt rounds for API key hashing

# ── ProxyPay Gateway ─────────────────────────────────────────────────────────
PROXYPAY_WEBHOOK_SECRET=               # type:string   required:true  | HMAC secret for validating inbound webhooks
PROXYPAY_API_BASE_URL=                 # type:url      required:true  | Base URL for the ProxyPay payment gateway
PROXYPAY_PARTNER_ID=                   # type:string   required:true  | ProxyPay partner account identifier
PROXYPAY_PARTNER_SECRET=               # type:string   required:true  | ProxyPay partner secret for request signing

# ── Security ─────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000  # type:string   required:false | Comma-separated allowed CORS origins
RATE_LIMIT_WINDOW_MS=900000            # type:number   required:false | Rate-limit window in ms (default 15 min)
RATE_LIMIT_MAX_REQUESTS=100            # type:number   required:false | Max requests per IP per window
ENCRYPTION_KEY=                        # type:string   required:true  | 32-byte hex key for AES-256 PII encryption

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info                         # type:string   required:false | error | warn | info | debug
LOG_FORMAT=json                        # type:string   required:false | json | pretty

# ── Email (SMTP) ─────────────────────────────────────────────────────────────
SMTP_HOST=                             # type:string   required:false | SMTP server hostname
SMTP_PORT=587                          # type:number   required:false | SMTP server port
SMTP_USER=                             # type:string   required:false | SMTP authentication username
SMTP_PASS=                             # type:string   required:false | SMTP authentication password
EMAIL_FROM=noreply@proxypay.io         # type:string   required:false | Sender address for outbound email

# ── File Storage (S3) ────────────────────────────────────────────────────────
S3_BUCKET=                             # type:string   required:false | AWS S3 bucket for uploads
S3_REGION=us-east-1                    # type:string   required:false | AWS region for S3 bucket
AWS_ACCESS_KEY_ID=                     # type:string   required:false | AWS access key ID
AWS_SECRET_ACCESS_KEY=                 # type:string   required:false | AWS secret access key

# ── Observability ────────────────────────────────────────────────────────────
SENTRY_DSN=                            # type:url      required:false | Sentry DSN for error tracking
FEATURE_FLAGS={}                       # type:json     required:false | JSON object of feature flag overrides
