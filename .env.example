# ProxyPay Frontend Environment Configuration
# Copy this file to .env.local and customize for your environment

# ============================================================================
# DEPLOYMENT CONFIGURATION
# ============================================================================

# Base URL for the documentation portal (used by Docusaurus)
# Examples: https://Pidoko257.github.io/proxypay-frontend/ (production)
#           http://localhost:3001 (development)
#           https://staging-docs.proxypay.io/proxypay-frontend/ (staging)
NEXT_PUBLIC_BASE_URL=http://localhost:3001

# GitHub organization and project name (for GitHub Pages deployment)
# Used in docusaurus.config.ts for deployment configuration
NEXT_PUBLIC_GITHUB_ORG=Pidoko257
NEXT_PUBLIC_GITHUB_REPO=proxypay-frontend

# GitHub Pages deployment branch
NEXT_PUBLIC_DEPLOYMENT_BRANCH=gh-pages

# ============================================================================
# API ENDPOINTS
# ============================================================================

# Backend API base URL for load testing and API calls
# Examples: http://localhost:3000 (development)
#           https://staging-api.proxypay.io (staging)
#           https://api.proxypay.io (production)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# OpenAPI specification URL (relative or absolute)
# Used by RedocViewer to load the API specification
NEXT_PUBLIC_OPENAPI_SPEC_URL=/openapi.yaml

# ============================================================================
# FEATURE FLAGS
# ============================================================================

# Enable demo mode (generates sample data instead of calling backend)
NEXT_PUBLIC_DEMO_MODE=false

# Enable load testing features in the UI
NEXT_PUBLIC_ENABLE_LOAD_TESTING=true

# Enable analytics dashboard
NEXT_PUBLIC_ENABLE_ANALYTICS=true

# Enable request history logging
NEXT_PUBLIC_ENABLE_REQUEST_HISTORY=true

# ============================================================================
# BUILD & RUNTIME CONFIGURATION
# ============================================================================

# Environment name (development, staging, production)
NODE_ENV=development

# Verbose logging for debugging
NEXT_PUBLIC_VERBOSE_LOGGING=false

# API request timeout (milliseconds)
NEXT_PUBLIC_API_TIMEOUT=30000

# ============================================================================
# LOAD TESTING CONFIGURATION
# ============================================================================

# Default load testing profile (smoke-test, normal-load, stress-test, spike-test, endurance-test)
NEXT_PUBLIC_DEFAULT_LOAD_PROFILE=normal-load

# Load testing output directory
NEXT_PUBLIC_LOAD_TEST_OUTPUT_DIR=./load-test-results

# Enable graph generation in load test reports
NEXT_PUBLIC_LOAD_TEST_GENERATE_GRAPHS=true

# ============================================================================
# ANALYTICS CONFIGURATION
# ============================================================================

# Analytics service endpoint (optional)
NEXT_PUBLIC_ANALYTICS_ENDPOINT=

# Analytics service API key (optional, keep secret if required)
NEXT_PUBLIC_ANALYTICS_KEY=

# ============================================================================
# SECURITY & AUTHENTICATION
# ============================================================================

# Bearer token for authenticated API requests
# WARNING: Do not commit this to version control; set only in CI/CD or .env.local
NEXT_PUBLIC_AUTH_TOKEN=

# CORS allowed origins (comma-separated if multiple)
NEXT_PUBLIC_ALLOWED_ORIGINS=

# ============================================================================
# DOCUSAURUS SPECIFIC
# ============================================================================

# Docusaurus base URL path (appended to domain)
# Must start and end with / if not root
NEXT_PUBLIC_DOCUSAURUS_BASE_URL=/proxypay-frontend/

# Docusaurus trailing slash behavior
NEXT_PUBLIC_DOCUSAURUS_TRAILING_SLASH=false

# ============================================================================
# LOGGING
# ============================================================================

# Log level (debug, info, warn, error)
NEXT_PUBLIC_LOG_LEVEL=info

# Enable structured logging (JSON format)
NEXT_PUBLIC_STRUCTURED_LOGGING=false
