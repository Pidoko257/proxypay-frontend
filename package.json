  "version": "1.0.0",
  "scripts": {
    "sync:openapi": "node -e \"if(!require('fs').existsSync('./static/openapi.yaml')){console.log('No openapi.yaml found in static/ — place your openapi.yaml in static/ before building.');}\"",
    "start": "docusaurus start --port 3001",
    "build": "docusaurus build",
