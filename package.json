    "keycharm": "^0.4.0",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "redoc": "^2.5.1",
    "vis-data": "^8.0.5",
    "vis-network": "^10.1.2",
    "vis-util": "^6.0.2"
  },
  "devDependencies": {
    "@docusaurus/types": "^3.10.2",
    "@types/jest": "^30.0.0",
    "identity-obj-proxy": "^3.0.0",
